# ==============================================================================
# Belka - конфигурация окружения (.env)
# Скопируйте этот файл в .env рядом с программой и укажите свои данные.
# Переменные окружения системы имеют приоритет над значениями из .env.
# ==============================================================================

# Общие настройки по умолчанию (переопределяются ключами командной строки)
CLOUD_PROVIDER=yandex
CLOUD_REMOTE_DIR=/Upload
# CLOUD_JOBS=2                 # параллельные загрузки (-j)
# CLOUD_URLS_FILE=urls.txt     # список ссылок (--urls-file)
# CLOUD_ASSET_FILTER=(?i)\.(apk|exe|zip|tar\.gz)$   # какие файлы релизов скачивать (--assets)
# BELKA_LOG=debug     # уровень логирования, можно по модулям: warn,belka_core=debug

# ------------------------------------------------------------------------------
# 1. Яндекс.Диск — OAuth-токен с доступом к REST API Диска, его выводит `belka --login yandex`
# ------------------------------------------------------------------------------
YANDEX_TOKEN=y0__your_yandex_oauth_token_here

# ------------------------------------------------------------------------------
# 2. Облако Mail.ru (WebDAV) — e-mail и пароль для внешних приложений
#    (Пароль и безопасность -> Пароли для внешних приложений).
#    Для CLI хватает уровня «Полный доступ к Облаку (WebDAV)».
# ------------------------------------------------------------------------------
MAILRU_USER=your_email@mail.ru
MAILRU_PASSWORD=your_mailru_app_password
# MAILRU_WEBDAV_URL=https://webdav.mail.ru

# ------------------------------------------------------------------------------
# 3. Google Drive (API v3)
#    Рекомендуется refresh token, его выводит `belka --login google`.
#    CLIENT_ID и CLIENT_SECRET нужны только для своего OAuth-приложения:
#    без них используется встроенное в сборку.
#    Альтернатива: GOOGLE_DRIVE_TOKEN — access token, живёт ~1 час.
# ------------------------------------------------------------------------------
GOOGLE_REFRESH_TOKEN=1//your_refresh_token
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_DRIVE_TOKEN=ya29.your_access_token

# ------------------------------------------------------------------------------
# 4. S3: AWS, Cloudflare R2, Backblaze B2, Wasabi, MinIO, Yandex Object Storage,
#    Selectel, VK Cloud, Timeweb и др. (path-style запросы). Адреса — в README, «Пресеты».
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=my-backups
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
# Регион подписи. Для R2, B2, Wasabi, AWS, Yandex, Selectel, VK Cloud, DigitalOcean
# определяется по адресу endpoint; для остальных по умолчанию us-east-1.
# S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. Synology NAS (File Station API) — пользователь DSM без двухфакторной аутентификации
# ------------------------------------------------------------------------------
SYNOLOGY_URL=192.168.1.10
SYNOLOGY_USER=your_dsm_user
SYNOLOGY_PASSWORD=your_dsm_password
# Порт DSM (Панель управления → Портал входа), по умолчанию 5000, для HTTPS 5001
# SYNOLOGY_PORT=5001
# SYNOLOGY_HTTPS=true
# true, если сертификат DSM самоподписанный
# SYNOLOGY_INSECURE=false

# ------------------------------------------------------------------------------
# 6. Универсальный WebDAV (Nextcloud, ownCloud, Koofr, pCloud, 4shared и др.)
# ------------------------------------------------------------------------------
WEBDAV_URL=https://nextcloud.example.com/remote.php/dav/files/user/
WEBDAV_USER=your_webdav_username
WEBDAV_PASSWORD=your_webdav_app_password
# true, только если ETag сервера — это MD5 содержимого файла (бывает редко)
# WEBDAV_ETAG_IS_MD5=false

# ------------------------------------------------------------------------------
# Шифрование (любой провайдер, формат rclone crypt). Пароль не восстанавливается!
# ------------------------------------------------------------------------------
# CRYPT_PASSWORD=your_encryption_password
# CRYPT_PASSWORD2=optional_salt          # password2 в rclone
# CRYPT_ROOT=/Encrypted                  # папка облака с зашифрованными файлами, по умолчанию /
# CRYPT_FILENAMES=standard               # standard (имена шифруются) или off

# ------------------------------------------------------------------------------
# 7. GitHub API (опционально) — снимает лимит 60 запросов/час при зеркалировании
# ------------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_your_github_token_here

# ------------------------------------------------------------------------------
# Уведомления о результате (любые каналы вместе). Проверка: belka --notify-test
# ------------------------------------------------------------------------------
# Telegram: токен бота от @BotFather и ID чата (личный, группа или канал)
# NOTIFY_TELEGRAM_TOKEN=123456789:AAH...
# NOTIFY_TELEGRAM_CHAT=123456789
# NOTIFY_TELEGRAM_API=https://api.telegram.org   # свой Bot API сервер или прокси
# Webhook: POST JSON; Slack, Discord, Mattermost принимают его без настройки
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# Пинг в стиле healthchecks.io: /start в начале, URL при успехе, /fail при ошибке
# NOTIFY_PING_URL=https://hc-ping.com/your-uuid
# Когда писать в Telegram и webhook: failure (по умолчанию) или always
# NOTIFY_ON=failure
# Название задания в сообщениях, если заданий несколько
# NOTIFY_NAME=nightly-db
